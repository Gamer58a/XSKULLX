iv\",null,{\"className\":\"rules-strip\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"How to practice\"}],[\"$\",\"h3\",null,{\"children\":\"Short comparison habits\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",\"Start with short pairs of tones and decide only whether the second one is higher or lower.\",{\"children\":\"Start with short pairs of tones and decide only whether the second one is higher or lower.\"}],[\"$\",\"li\",\"Repeat one listening pattern several times before changing ranges or instruments.\",{\"children\":\"Repeat one listening pattern several times before changing ranges or instruments.\"}],[\"$\",\"li\",\"Use browser drills that let you hear, decide, and retry quickly instead of reading theory between every attempt.\",{\"children\":\"Use browser drills that let you hear, decide, and retry quickly instead of reading theory between every attempt.\"}]]}]]}],[[\"$\",\"div\",\"What makes pitch harder than expected\",{\"className\":\"rules-strip\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"What makes pitch harder than expected\"}],[\"$\",\"p\",null,{\"children\":\"Pitch perception is not a single skill — it is a stack of smaller judgments happening at once. Your brain has to detect the fundamental frequency, ignore overtones that color the sound, compare what you hear now against a fading memory of what you heard a moment ago, and then translate all of that into a direction (higher or lower) and a distance (by how much). When any link in that chain is weak, the whole estimate drifts. That is why someone can have a good musical ear yet still struggle with isolated sine tones: the usual harmonic context they rely on is stripped away, and the raw pitch judgment is exposed"])</script><script>self.__next_f.push([1,".\"}]]}],\"$L12\",\"$L13\"],null,null,null,\"$L14\",\"$L15\",\"$L16\"]}]]}]]}]],null,\"$L17\"]}]\nf:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L18\",null,{\"children\":\"$L19\"}],null],[\"$\",\"$L1a\",null,{\"children\":