trip\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"How to practice\"}],[\"$\",\"h3\",null,{\"children\":\"Short comparison habits\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",\"Start with one simple question per round: higher or lower, same or different, close or far.\",{\"children\":\"Start with one simple question per round: higher or lower, same or different, close or far.\"}],[\"$\",\"li\",\"Keep sessions short so your ear stays fresh instead of turning every attempt into a test.\",{\"children\":\"Keep sessions short so your ear stays fresh instead of turning every attempt into a test.\"}],[\"$\",\"li\",\"Use repeated browser rounds to learn your own miss pattern before adding harder musical context.\",{\"children\":\"Use repeated browser rounds to learn your own miss pattern before adding harder musical context.\"}]]}]]}],[[\"$\",\"div\",\"What counts as ear training\",{\"className\":\"rules-strip\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"What counts as ear training\"}],[\"$\",\"p\",null,{\"children\":\"Ear training is any deliberate practice that improves how accurately you hear, compare, or identify sounds. It does not require a piano, music theory knowledge, or perfect pitch. If you listen to two tones and decide which is higher, that is ear training. If you hear a chord and try to sing the root note, that counts too. The common thread is focused listening followed by some form of feedback. Casual music listening is enjoyable but passive — ear training adds a judgment step that forces your brain to process the sound instead of letting it wash over you.\"}]]}],\"$L12\",\"$L13\",\"$L14\"],null,null,null,\"$L15\",\"$L16\",\"$L17\"]}]]}]]}]],null,\"$L18\"]}]\nf:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L19\",null,{\"children\":\"$"])</script><script>self.__next_f.push([1,"L1a\"}],null],[\"$\",\"$L1b\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$1c\",null,{\"fallback\":null,\"children\":\"$L1d\"}]}]