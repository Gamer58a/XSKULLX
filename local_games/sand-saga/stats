  <script>
    
document.addEventListener('DOMContentLoaded', function() {
    function formatNumberValue(number) {
        return number.toLocaleString();
    }

    // scenario stats

    let tableBody = document.getElementById('scenario-stats-table-body');
    for (let i = 0; i < STATS_BY_SCENARIO.dataNames.length; i++) {
        let scenario = STATS_BY_SCENARIO.dataNames[i];
        let updates = STATS_BY_SCENARIO.dataUpdates[i];
        let completed = STATS_BY_SCENARIO.dataCompleted[i];

        let index = tableBody.rows.length - 1;
        let tableRow = tableBody.insertRow(index);

        let cellName = document.createElement('td');
        cellName.textContent = scenario;
        tableRow.appendChild(cellName);

        let cellUpdates = document.createElement('td');
        cellUpdates.className = 'value-cell';
        cellUpdates.textContent = formatNumberValue(updates);
        tableRow.appendChild(cellUpdates);

        let cellUpdatesIndicator = document.createElement('td');
        cellUpdatesIndicator.className = 'value-cell';
        cellUpdatesIndicator.innerHTML = Number(updates / STATS.updates * 100).toFixed(2) + '&nbsp;%';
        tableRow.appendChild(cellUpdatesIndicator);

        let cellCompleted = document.createElement('td');
        cellCompleted.className = 'value-cell';
        cellCompleted.textContent = formatNumberValue(completed);
        tableRow.appendChild(cellCompleted);

        let cellCompletedIndicator = document.createElement('td');
        cellCompletedIndicator.className = 'value-cell';
        cellCompletedIndicator.innerHTML = Number(completed / STATS.completed * 100).toFixed(2) + '&nbsp;%';
        tableRow.appendChild(cellCompletedIndicator);
    }

    document.getElementById('scenario-stats-total-updates').innerText = formatNumberValue(STATS.updates) + '*';
    document.getElementById('scenario-stats-total-completed').innerText = formatNumberValue(STATS.completed);

    document.getElementById('scenario-stats-summary').innerHTML = '<i>'
        + '*Played = ' + formatNumberValue(STATS.updates) + ' minutes'
        + ' &asymp; ' + formatNumberValue(Math.trunc(STATS.updates / 60)) + ' hours'
        + ' &asymp; ' + formatNumberValue(Math.trunc(STATS.updates / 60 / 24)) + ' days'
        + ' &asymp; ' + formatNumberValue((STATS.updates / 60 / 24 / 365).toFixed(1)) + ' years'
        + '</i>';

    // day stats

    if (STATS_BY_DAY.dataDays.length > 0) {
        let dayStatsLast = document.getElementById('day-stats-last');

        function addLastDay(i) {
            let lastDay = STATS_BY_DAY.dataDays[i];
            let lastUpdates = formatNumberValue(STATS_BY_DAY.dataUpdates[i]);
            let lastCompleted = formatNumberValue(STATS_BY_DAY.dataCompleted[i]);
            let html = '<p><strong>' + lastDay + '</strong> – Minutes Played: ' + lastUpdates + ', Completed: ' + lastCompleted + '</p>';
            dayStatsLast.insertAdjacentHTML('beforeend', html);
        }

        for (let i = 0; i < Math.min(STATS_BY_DAY.dataDays.length, 3); i++) {
            addLastDay(i);
        }
    }

    function countDayAverage(array, count) {
        let result = [];

        for (let i = 0; i < array.length; i++) {
            let sum = 0;
            let divisor = Math.min(count, i + 1);

            for (let j = 0; j < divisor; j++) {
                sum += array[i - j];
            }

            result.push(Math.round(sum / divisor));
        }

        return result;
    }

    let labels = STATS_BY_DAY.dataDays.reverse();
    let dataMinutesPlayed = STATS_BY_DAY.dataUpdates.reverse();
    let dataCompleted = STATS_BY_DAY.dataCompleted.reverse();
    let dataMinutesPlayed7dAverage = countDayAverage(dataMinutesPlayed, 7);
    let dataCompleted7dAverage = countDayAverage(dataCompleted, 7);

    let chartAspectRatio = 2.5;
    if (window.innerWidth < 1000) {
        chartAspectRatio = 2;
    } if (window.innerWidth < 500) {
        chartAspectRatio = 1;
    }

    // Add button group for day range selection
    let chartContainer = document.getElementById('day-stats-chart').parentElement;
    let buttonGroupHTML = `
        <div class="text-center">
            <div class="btn-group mb-3" role="group" aria-label="Day range selection">
                <button type="button" class="btn btn-outline-secondary active" data-days="all">All</button>
                <button type="button" class="btn btn-outline-secondary" data-days="365">Last 365 days</button>
                <button type="button" class="btn btn-outline-secondary" data-days="180">Last 180 days</button>
                <button type="button" class="btn btn-outline-secondary" data-days="90">Last 90 days</button>
            </div>
        </div>
    `;
    document.getElementById('day-stats-chart').insertAdjacentHTML('beforebegin', buttonGroupHTML);

    function updateChartData(dayRange) {
        let filteredLabels, filteredMinutesPlayed, filteredCompleted, filteredMinutesPlayed7dAverage,
            filteredCompleted7dAverage;

        if (dayRange === 'all') {
            filteredLabels = labels;
            filteredMinutesPlayed = dataMinutesPlayed;
            filteredCompleted = dataCompleted;
            filteredMinutesPlayed7dAverage = dataMinutesPlayed7dAverage;
            filteredCompleted7dAverage = dataCompleted7dAverage;
        } else {
            let startIndex = Math.max(0, labels.length - dayRange);
            filteredLabels = labels.slice(startIndex);
            filteredMinutesPlayed = dataMinutesPlayed.slice(startIndex);
            filteredCompleted = dataCompleted.slice(startIndex);
            filteredMinutesPlayed7dAverage = dataMinutesPlayed7dAverage.slice(startIndex);
            filteredCompleted7dAverage = dataCompleted7dAverage.slice(startIndex);
        }

        chart.data.labels = filteredLabels;
        chart.data.datasets[0].data = filteredMinutesPlayed;
        chart.data.datasets[1].data = filteredMinutesPlayed7dAverage;
        chart.data.datasets[2].data = filteredCompleted;
        chart.data.datasets[3].data = filteredCompleted7dAverage;
        chart.update();
    }

    let config = {
        type: 'line',
        data: {
            labels: labels,
            datasets: [
                {
                    label: "Minutes Played",
                    yAxisID: 'y1',
                    data: dataMinutesPlayed,
                    borderColor: 'rgb(0,65,100)',
                    backgroundColor: 'rgba(0,65,100,0.2)',
                    cubicInterpolationMode: 'monotone',
                },
                {
                    label: "Minutes Played (7-day avg)",
                    yAxisID: 'y1',
                    data: dataMinutesPlayed7dAverage,
                    borderColor: 'rgb(12,114,168)',
                    backgroundColor: 'rgba(0,65,100,0.2)',
                    cubicInterpolationMode: 'monotone',
                },
                {
                    label: "Completed",
                    hidden: true,
                    yAxisID: 'y2',
                    data: dataCompleted,
                    borderColor: 'rgb(0,100,0)',
                    backgroundColor: 'rgba(0,100,0,0.2)',
                    cubicInterpolationMode: 'monotone',
                },
                {
                    label: "Completed (7-day avg)",
                    hidden: true,
                    yAxisID: 'y2',
                    data: dataCompleted7dAverage,
                    borderColor: 'rgb(24,184,24)',
                    backgroundColor: 'rgba(0,100,0,0.2)',
                    cubicInterpolationMode: 'monotone',
                }
            ]
        },
        options: {
            responsive: true,
            aspectRatio: chartAspectRatio,
            scales: {
                x: {
                    title: {
                        display: true,
                        text: 'Day'
                    }
                },
                y1: {
                    stacked: false,
                    title: {
                        display: true,
                        text: 'Minutes Played'
                    },
                    position: 'left',
                    beginAtZero: true,
                    min: 0
                },
                y2: {
                    stacked: false,
                    title: {
                        display: true,
                        text: 'Completed'
                    },
                    position: 'right',
                    beginAtZero: true,
                    min: 0
                }
            },
            plugins: {
                title: {
                    display: true,
                    text: (ctx) => 'Day stats'
                },
                tooltip: {
                    mode: 'index'
                },
            },
            interaction: {
                mode: 'nearest',
                axis: 'x',
                intersect: false
            },
            animations: false,
        }
    };
    let chart = new Chart(document.getElementById('day-stats-chart'), config);

    // Add event listeners to button group
    let buttons = chartContainer.querySelectorAll('.btn-group button');
    buttons.forEach(button => {
        button.addEventListener('click', function () {
            buttons.forEach(btn => btn.classList.remove('active'));
            this.classList.add('active');

            let dayRange = this.getAttribute('data-days');
            updateChartData(dayRange === 'all' ? 'all' : parseInt(dayRange));
        });
    });
});
  </script>
