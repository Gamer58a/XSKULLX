  <script>
    var COUNT_SUPPORTERS = 255;
    
function paypalErrorMessage(message) {
    const container = document.querySelector("#paypal-result-err");
    container.innerText = message;
}

function paypalSuccessMessage(message) {
    const container = document.querySelector("#paypal-result-success");
    container.innerText = message;
}

function getPaypalAmountSliderValue() {
    const values = ["7.50", "10.00", "15.00", "20.00", "30.00", "50.00"];
    const slider = document.getElementById('paypal-slider-amount');
    const index = slider.value;
    return values[index];
}

function getPaypalAmountSliderText() {
    const values = ["Every grain of sand counts.", "Fair enough 🤝", "Cool!", "Coool! ", "Cooool! You’re in the VIP club now! 🔥", "Coooool! Absolute legend! 🏆"];
    const slider = document.getElementById('paypal-slider-amount');
    const index = slider.value;
    return values[index];
}

document.addEventListener('DOMContentLoaded', function() {
    let statsAnchor = document.getElementById('stats-anchor');
    if (statsAnchor !== undefined && window.COUNT_SUPPORTERS !== undefined) {
        statsAnchor.innerText = '' + COUNT_SUPPORTERS;
    }

    if (window.USER_ROLE !== undefined) {
        // init supporter's badge
        if (USER_ROLE === 'supporter') {
            let anchor = document.getElementById('thank-you-anchor');
            let badge = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" fill="#fc2c03" width="32">' +
                '<title>Supporter\'s badge</title>' +
                '<path d="M39.8 0 0 10.3v27.2C0 74 26.5 96.8 39.8 100c13.3-3.1 39.8-26 39.8-62.4V10.3zm12 48.5L57.6 68l-1.4 1-16.7-11.6-16.9 11.8-1.3-.9 6-19.8L10.6 36l.2-1.3 21.2-.2 6.7-19.1h1.7L47 34.4l21 .3.5 1.1z"/>' +
                '</svg>';
            anchor.innerHTML = '<div class="alert alert-success" role="alert">' + badge + ' Thank you for supporting Sand Saga :)</div>';
        }

        // hide steps
        document.getElementById('paypal-support-steps').remove();

        // show PayPal part
        document.getElementById('paypal-part').style.display = 'block';

        // init slider
        function updateDisplayAmount() {
            const displayAmount = document.getElementById('paypal-display-amount');
            displayAmount.innerHTML = getPaypalAmountSliderValue() + ' USD <span style="padding-left: 1em; font-size: small;">' + getPaypalAmountSliderText() + '</span>';
        }
        document.getElementById('paypal-slider-amount').addEventListener('input', updateDisplayAmount);
        updateDisplayAmount();

        // init paypal
        if (window.paypal === undefined || window.paypal.Buttons === undefined) {
            paypalErrorMessage('PayPal payment gateway not available');
            return;
        }
    } else {
        // not logged - do not show payment gateway
        return;
    }

    let lastAmountSelectedStr = null;
    window.paypal.Buttons({
        style: {
            shape: 'rect',
            layout: 'vertical',
        },
        async createOrder() {
            lastAmountSelectedStr = null;
            paypalSuccessMessage('');
            paypalErrorMessage('');

            try {
                lastAmountSelectedStr = getPaypalAmountSliderValue();
                const queryParams = new URLSearchParams({
                    'amount-value': lastAmountSelectedStr,
                    'amount-currency': 'USD',
                });
                const response = await fetch('/api/user/support/paypal/create-order?' + queryParams, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: ''
                });

                if (!response.ok) {
                    throw 'Create order failed with status ' + response.status;
                }

                const orderText = await response.text();
                let orderData;
                try {
                    orderData = JSON.parse(orderText);
                } catch (e) {
                    throw 'Unknown error';
                }

                if (orderData.id) {
                    return orderData.id;
                } else {
                    const errorDetail = orderData?.details?.[0];
                    const errorMessage = errorDetail
                        ? `${errorDetail.issue} ${errorDetail.description} (${orderData.debug_id})`
                        : 'Id not obtained';

                    throw errorMessage;
                }
            } catch (error) {
                console.error(error);
                paypalErrorMessage('Could not initiate PayPal Checkout: ' + error);
            }
        },
        async onApprove(data, actions) {
            function triggerPurchaseAnalytics(transactionId, amountStr, amountCurrency) {
                try {
                    if (window.gtag === undefined) {
                        return;
                    }

                    gtag("event", "purchase", {
                        transaction_id: transactionId,
                        value: Number.parseFloat(amountStr),
                        currency: amountCurrency,
                        items: [{
                            item_id: "general-donation",
                            item_name: "General Donation",
                            item_variant: amountStr,
                            price: Number.parseFloat(amountStr),
                            quantity: 1
                        }]
                    });
                } catch (e) {
                    // ignore
                }
            }

            try {
                const orderID = data.orderID;
                const queryParams = new URLSearchParams({
                    'order-id': orderID,
                });
                const response = await fetch('/api/user/support/paypal/capture-order?' + queryParams, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                if (!response.ok) {
                    throw 'Approve order failed with status ' + response.status;
                }

                const orderText = await response.text();
                let orderData;
                try {
                    orderData = JSON.parse(orderText);
                } catch (e) {
                    throw 'Unknown error';
                }

                // Three cases to handle:
                //   (1) Recoverable INSTRUMENT_DECLINED -> call actions.restart()
                //   (2) Other non-recoverable errors -> Show a failure message
                //   (3) Successful transaction -> Show confirmation or thank you message

                const errorDetail = orderData?.details?.[0];

                if (errorDetail?.issue === "INSTRUMENT_DECLINED") {
                    // (1) Recoverable INSTRUMENT_DECLINED -> call actions.restart()
                    // recoverable state, per https://developer.paypal.com/docs/checkout/standard/customize/handle-funding-failures/
                    return actions.restart();
                } else if (errorDetail) {
                    // (2) Other non-recoverable errors -> Show a failure message
                    throw `${errorDetail.description} (${orderData.debug_id})`;
                } else if (!orderData.purchase_units) {
                    throw JSON.stringify(orderData);
                } else {
                    // (3) Successful transaction -> Show confirmation or thank you message
                    // Or go to another URL:  actions.redirect('thank_you.html');
                    triggerPurchaseAnalytics(orderID, lastAmountSelectedStr, 'USD');
                    paypalSuccessMessage('Transaction completed successfully. The page will be refreshed...');
                    setTimeout(function() { location.reload() }, 3000);
                }
            } catch (error) {
                console.error(error);
                paypalErrorMessage('Sorry, your transaction could not be processed: ' + error);
            }
        }
    }).render("#paypal-button-container");
});

