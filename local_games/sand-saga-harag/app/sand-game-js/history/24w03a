<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="Description" content="A legacy version of Sand Game JS - falling sand game.">
  <title>Sand Game JS / 24w03a</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
          integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
  <style>
      /* override xx-large breakpoint */
      @media (min-width: 1400px)  {
          .container {
              max-width: 1140px;
          }
      }
  </style>

    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HLHEV50NKX"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-HLHEV50NKX');
    </script>
  <link rel="stylesheet" type="text/css" href="https://files.harag.cz/www/app/sand-game-js/prod/24w03a/sand-game-js.css">
  <script defer src="https://files.harag.cz/www/app/sand-game-js/prod/24w03a/sand-game-js.umd.min.js"></script>
  <script>
      // global variables, accessible from browser console
      var sandGame = null;
      var brushes = null;

      document.addEventListener('DOMContentLoaded', () => {
          if (window.SandGameJS !== undefined) {
              const root = document.getElementById('sand-game-root');

              const config = {
                  version: '24w03a',
                  debug: false
              };
              const controller = SandGameJS.init(root, config);
              sandGame = controller.getSandGame();
              controller.addOnInitialized(s => {
                  sandGame = s;
              });
              brushes = SandGameJS.brushes;
              console.log('Globals:');
              console.log('  sandGame, brushes');
              console.log('Examples:');
              console.log('  sandGame.graphics().drawLine(10, 10, 300, 150, 2, brushes.sand);');
              console.log('  sandGame.graphics().draw(100, 20, brushes.meteor);');
          } else {
              const placeholder = document.getElementById('sand-game-placeholder-content');
              placeholder.innerHTML = '<span style="color: red; font-weight: bold;">' +
                  'Failed to load the game. Possible reasons:<br>' +
                  '&bull; Your browser may not support modern JavaScript<br>' +
                  '&bull; Internet connection<br>' +
                  '&bull; A server side problem' +
                  '</span>';
          }
      });
  </script>
</head>
<body>
<main role="main" class="container"><div class="row"><div class="col-12">
  <a href="/app/sand-game-js/history" class="d-none d-md-block" style="float: right; margin-top: 0.5rem;">Back to version history</a>
  <h1 style="font-size: 2rem; margin-top: 0.5rem;">Sand Game JS / 24w03a</h1>

  <div class="alert alert-warning alert-dismissible fade show" role="alert">
    You are playing an older version. Some features may not be available / work differently etc. <br>
    Click <a href="/app/sand-game-js">here</a> to play the latest version (game state will be lost).
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>


  <div id="sand-game-root">
    <!-- Sand Game JS placeholder -->
    <div style="user-select: none;">
      <div>
        <button disabled class="btn" type="button" style="min-width: 4em; line-height: 2; padding: 0 0.4em 0 0.4em; font-size: 75%; border: none; background-color: rgb(230, 230, 230); color: black;">&nbsp;</button>
      </div>
      <div style="height: 70vh; display: flex; align-items: center; justify-content: center; margin-top: 4pt; padding: 2em; outline: 1px solid #b7b7b7;">
        <div id="sand-game-placeholder-content">
          Loading...
        </div>
      </div>
      <div style="height: 20vh"></div>
    </div>
  </div>
</div></div></main>
</body>
</html>