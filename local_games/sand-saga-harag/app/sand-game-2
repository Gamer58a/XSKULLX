    function harag_cz_comment(replyTo) {
        document.getElementById('dialog-comment_title').textContent = replyTo ? 'Reply' : 'Post Comment';
        document.getElementById('dialog-comment_reply').value = replyTo;
        document.getElementById('dialog-comment_error-message-wrapper').innerHTML = '';

