<script>
    function harag_cz_comment(replyTo) {
        document.getElementById('dialog-comment_title').textContent = replyTo ? 'Reply' : 'Post Comment';
        document.getElementById('dialog-comment_reply').value = replyTo;
        document.getElementById('dialog-comment_error-message-wrapper').innerHTML = '';

        const dialogNode = document.getElementById('dialog-comment');
        const modal = new window.bootstrap.Modal(dialogNode);
        modal.show();
    }

    function harag_cz_sendComment() {
        document.getElementById('dialog-comment_error-message-wrapper').innerHTML = '';

        let formComment = document.getElementById('form-comment');
        let serialized = new FormData(formComment);
        let dataToSend = {};

        for (let [key, value] of serialized.entries()) {
            dataToSend[key] = key.startsWith('test') ? value === 'on' : value;
        }

        fetch(`/discussion/app-sand-saga`, {
                method: 'POST',
                body: JSON.stringify(dataToSend),
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => {
                if (response.ok) {
                    document.getElementById('dialog-comment_content').value = '';
                    alert('Submitted successfully. Your comment will be visible after page reload.');
                } else if (response.status === 400) {
                    harag_cz_sendCommentHandleError('check the form again');
                } else {
                    harag_cz_sendCommentHandleError(response.statusText);
                }
            })
            .catch(error => {
                harag_cz_sendCommentHandleError(error);
            });
    }

    function harag_cz_sendCommentHandleError(error) {
        setTimeout(() => {
            const alert = document.createElement('div');
            alert.setAttribute('role', 'alert');
            alert.setAttribute('class', 'alert alert-danger');
            alert.append('Submit failed: ' + error);

            const messageWrapper = document.getElementById('dialog-comment_error-message-wrapper');
            messageWrapper.append(alert);

            const dialogNode = document.getElementById('dialog-comment');
            const modal = new window.bootstrap.Modal(dialogNode);
            modal.show();
        }, 0);
    }

</script>

